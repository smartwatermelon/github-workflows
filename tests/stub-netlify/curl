#!/usr/bin/env bash
# Stub curl for test-wait-for-production.sh. Fixtures: token, site.json,
# deploys.<n>.json (nth call; last repeats). argv goes to calls.log.

# The token must arrive as `-K -` config on stdin, else HTTP 401 (exit 22).
set -euo pipefail
: "${STUB_DIR:?}"
printf '%s\n' "$*" >>"${STUB_DIR}/calls.log"
config="" url=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -K) [[ "$2" == "-" ]] && config="$(cat)"; shift 2 ;;
    --max-time) shift 2 ;;
    -*) shift ;;
    *) url="$1"; shift ;;
  esac
done
want="header = \"Authorization: Bearer $(cat "${STUB_DIR}/token")\""
if [[ "${config}" != "${want}" ]]; then
  echo "curl: (22) The requested URL returned error: 401" >&2
  exit 22
fi
api="https://api.netlify.com/api/v1"
case "${url}" in
  "${api}/sites/"*".netlify.app/deploys?per_page=20")
    n=$(($(cat "${STUB_DIR}/deploys.count" 2>/dev/null || echo 0) + 1))
    echo "${n}" >"${STUB_DIR}/deploys.count"
    f="${STUB_DIR}/deploys.${n}.json"
    while [[ ! -f "${f}" && "${n}" -gt 1 ]]; do n=$((n - 1)); f="${STUB_DIR}/deploys.${n}.json"; done
    cat "${f}" ;;
  "${api}/sites/"*".netlify.app")
    cat "${STUB_DIR}/site.json" ;;
  *)
    echo "curl: (22) The requested URL returned error: 404" >&2
    exit 22 ;;
esac
